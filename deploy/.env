# deploy/compose.yaml 使用的环境文件。公开镜像的首次安装见 deploy/README.md。
# 浏览器、客户端和 WSS 共用此 Origin，RP ID 取主机名。
CHIRP_PUBLIC_ORIGIN=https://chirp.xxxxxx.com

# 同机原生 Nginx 默认连接 127.0.0.1，容器或异机反代见 docs/server-operations.md。
CHIRP_HTTP_PUBLISH_IP=0.0.0.0
CHIRP_LOG_LEVEL=info
# 可选，默认关闭；只可以使用基于 VictoriaLogs 搭建的日志服务器。
# 开启后每条日志立即进入内存发送队列，不保存本地日志文件。
CHIRP_LOG_SERVER_ENABLED=false
CHIRP_LOG_SERVER_URL=https://logs.chirp.xxxxxx.com
CHIRP_TOKEN_TTL=5m
CHIRP_GROUP_ROTATION=60s

# 只填写一次；Compose 同时注入 app 和 LiveKit，无需再修改 YAML 中的 keys。
LIVEKIT_API_KEY=chirp
# openssl rand -hex 32

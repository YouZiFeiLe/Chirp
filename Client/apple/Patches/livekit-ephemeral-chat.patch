+extension LocalParticipant {
+    /// An encrypted-only send pinned to the caller's original key provider and
+    /// short authorization. Publisher negotiation cannot move it into a new epoch.
+    public func chirpPublishEncrypted(data: Data, topic: String, destinations: [Participant.Identity],
+                                      keyProvider: BaseKeyProvider, authorization: @escaping @Sendable () -> Bool) async throws {
+        let room = try requireRoom()
+        try await room.ensureDataChannelReady(kind: .reliable)
+        try Task.checkCancellation()
+        guard room.connectionState == .connected, let identity, let sid, !destinations.isEmpty else {
+            throw LiveKitError(.invalidState, message: "Encrypted sending identity is unavailable")
+        }
+        let packet = Livekit_DataPacket.with {
+            $0.kind = .reliable
+            $0.participantIdentity = identity.stringValue
+            $0.participantSid = sid.stringValue
+            $0.destinationIdentities = destinations.map(\.stringValue)
+            $0.user = .with {
+                $0.participantIdentity = identity.stringValue
+                $0.topic = topic
+                $0.payload = data
+            }
+        }
+        try await room.publisherDataChannel.send(dataPacket: packet, chirpKeyProvider: keyProvider,
+                                                  chirpAuthorization: authorization)
+    }
+}

+    // Preloading must not change currentKeyIndex: data-channel encryption reads
+    // it directly. Only the ordered RTP activation barrier may advance it.
+    func chirpStageKeys(_ keys: [String: Data], index: Int32) -> Bool {
+        _state.mutate { state in
+            guard !state.chirpRetired, !options.sharedKey, index >= 0, index < options.keyRingSize,
+                  index != state.currentKeyIndex, !keys.isEmpty,
+                  Set(keys.keys) == Set(state.chirpKeySlots.keys), keys.values.allSatisfy({ $0.count == 32 }) else { return false }
+            for (identity, key) in keys {
+                rtcKeyProvider.setKey(key, with: index, forParticipant: identity)
+                state.chirpKeySlots[identity, default: []].insert(index)
+            }
+            return true
+        }
+    }
+
+    func chirpActivateKeyIndex(_ index: Int32) -> Bool {
+        _state.mutate { state in
+            guard !state.chirpRetired, !options.sharedKey, index >= 0, index < options.keyRingSize,
+                  !state.chirpKeySlots.isEmpty, state.chirpKeySlots.values.allSatisfy({ $0.contains(index) }) else { return false }
+            state.currentKeyIndex = index
+            state.keyIndexGeneration += 1
+            return true
+        }
+    }
+
+    func chirpRetireKeyIndex(_ index: Int32) -> Bool {
+        _state.mutate { state in
+            guard !state.chirpRetired, !options.sharedKey, index >= 0, index < options.keyRingSize,
+                  index != state.currentKeyIndex else { return false }
+            for identity in Array(state.chirpKeySlots.keys) where state.chirpKeySlots[identity]?.contains(index) == true {
+                var tombstone = SymmetricKey(size: .bits256).withUnsafeBytes { Data($0) }
+                rtcKeyProvider.setKey(tombstone, with: index, forParticipant: identity)
+                tombstone.resetBytes(in: 0..<tombstone.count)
+                state.chirpKeySlots[identity]?.remove(index)
+            }
+            return true
+        }
+    }

<UserControl x:Class="Chirp.SpeakingHalo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
  <Grid>
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="PulseStates">
        <VisualState x:Name="Still"/>
        <VisualState x:Name="Pulsing">
          <Storyboard RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="WaveScale" Storyboard.TargetProperty="ScaleX"
                             From="0.73" To="1" Duration="0:0:1.1"/>
            <DoubleAnimation Storyboard.TargetName="WaveScale" Storyboard.TargetProperty="ScaleY"
                             From="0.73" To="1" Duration="0:0:1.1"/>
            <DoubleAnimation Storyboard.TargetName="Wave" Storyboard.TargetProperty="Opacity"
                             From="0.9" To="0" Duration="0:0:1.1"/>
          </Storyboard>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <Ellipse x:Name="Wave" Stroke="{ThemeResource SpeakingInkBrush}" StrokeThickness="3"
             Opacity="0" RenderTransformOrigin="0.5,0.5">
      <Ellipse.RenderTransform><ScaleTransform x:Name="WaveScale"/></Ellipse.RenderTransform>
    </Ellipse>
    <Ellipse Margin="10" Stroke="{ThemeResource SpeakingInkBrush}" StrokeThickness="3"/>
  </Grid>
</UserControl>

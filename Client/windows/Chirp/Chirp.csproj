<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.26100.0</TargetPlatformMinVersion>
    <Version>2026.11.24.1</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishTrimmed>false</PublishTrimmed>
    <NativeOutput>$(MSBuildThisFileDirectory)..\..\..\.build\winui-native</NativeOutput>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>
  <PropertyGroup Condition="'$(WindowsPackageType)' == 'None'">
    <DefineConstants>$(DefineConstants);CHIRP_UNPACKAGED</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinUIAnalyzer" PrivateAssets="all" />
    <PackageReference Include="NAudio.Wasapi" />
    <PackageReference Include="Concentus" />
    <!-- Concentus loads opus.dll from this package to decode DTX frames after speech. -->
    <PackageReference Include="OpusSharp.Natives" />
    <PackageReference Include="QRCoder" />
    <Manifest Include="$(ApplicationManifest)" />
    <PackageReference Include="ZXing.Net" />
    <ProjectCapability Include="Msix" />
    <EmbeddedResource Include="..\..\apple\Shared\Resources\zh-Hans.lproj\Errors.strings" LogicalName="Chirp.Errors.zh" />
    <EmbeddedResource Include="..\..\apple\Shared\Resources\en.lproj\Errors.strings" LogicalName="Chirp.Errors.en" />
    <EmbeddedResource Include="..\..\apple\Shared\Resources\zh-Hans.lproj\Localizable.strings" LogicalName="Chirp.Interface.zh" />
    <EmbeddedResource Include="..\..\apple\Shared\Resources\en.lproj\Localizable.strings" LogicalName="Chirp.Interface.en" />
    <Content Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(NativeOutput)\Chirp.Protocol.exe;$(NativeOutput)\chirp_mls_native.dll;$(NativeOutput)\chirp_windows_audio.dll;$(NativeOutput)\Chirp.RNNoise.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(NativeOutput)\AuthorizationTrust.json" Link="AuthorizationTrust.json" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
    <Content Include="..\..\apple\Audio\Sources\ChirpAudio\RNNoise-LICENSE.txt" Link="Licenses\RNNoise.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(NativeOutput)\mls-third-party.txt" Link="Licenses\Rust.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(NativeOutput)\go-third-party.txt" Link="Licenses\Go.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(NativeOutput)\dotnet-third-party.txt" Link="Licenses\DotNet.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\apple\Shared\Resources\Sounds\*.mp3" Link="Sounds\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="BuildChirpProtocol" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="pwsh -NoProfile -NonInteractive -File &quot;$(MSBuildThisFileDirectory)..\scripts\Build-Native.ps1&quot; -ProjectAssetsFile &quot;$(ProjectAssetsFile)&quot;" />
  </Target>
</Project>

<Page x:Class="Chirp.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Chirp">
  <Grid>
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="RoomTrustStates">
        <VisualState x:Name="NormalRoom"/>
        <VisualState x:Name="RoomAwaitingVerification">
          <VisualState.Setters>
            <Setter Target="RoomFrame.Background" Value="{ThemeResource RoomVerificationCanvasBrush}"/>
            <Setter Target="RoomCover.Background" Value="{ThemeResource RoomVerificationSurfaceBrush}"/>
            <Setter Target="ChatPanel.Background" Value="{ThemeResource RoomVerificationCanvasBrush}"/>
            <Setter Target="ChatComposer.Background" Value="{ThemeResource RoomVerificationSurfaceBrush}"/>
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <InfoBar x:Name="ClockNotice" AutomationProperties.AutomationId="NetworkClockNotice"
             IsClosable="False" IsOpen="False" Visibility="Collapsed" Margin="12,8,12,0">
      <StackPanel x:Name="ClockActions" Orientation="Horizontal" Spacing="8">
        <Button x:Name="ClockSettings" Click="ClockSettingsClick" AutomationProperties.AutomationId="OpenTimeSettings"/>
        <Button x:Name="ClockRetry" Click="ClockRetryClick" AutomationProperties.AutomationId="RetryClockCheck"/>
      </StackPanel>
    </InfoBar>
    <ScrollViewer x:Name="LoginGrid" Grid.Row="1" SizeChanged="LoginSizeChanged"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
      <Grid x:Name="LoginViewport" Padding="24">
        <Border x:Name="LoginCard" Style="{StaticResource ChirpCard}" Padding="0" MaxWidth="1000" VerticalAlignment="Center">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition x:Name="BrandColumn" Width="1.08*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="LoginForm" Grid.Column="1" MaxWidth="490" Padding="38,34" VerticalAlignment="Center" Spacing="22">
              <StackPanel Spacing="6">
                <TextBlock x:Name="LoginHeading" Style="{StaticResource ChirpHeading}" FontSize="32"
                           AutomationProperties.HeadingLevel="Level1"/>
                <TextBlock x:Name="LoginIntro" Style="{StaticResource ChirpSecondary}"/>
              </StackPanel>
              <StackPanel Spacing="8">
                <TextBox x:Name="Address" AutomationProperties.AutomationId="ServerAddress" MinHeight="40"
                         PlaceholderText="chirp.example.com" TextChanged="AddressChanged" KeyDown="AddressKey"/>
                <Button x:Name="ConnectButton" AutomationProperties.AutomationId="ConnectServer" Click="ConnectClick"
                        HorizontalAlignment="Stretch" Style="{StaticResource ChirpPrimary}"/>
                <StackPanel x:Name="AuthActions" Spacing="8" Visibility="Collapsed">
                  <Button x:Name="Passkey" AutomationProperties.AutomationId="PasskeyLogin" HorizontalAlignment="Stretch"
                          Style="{StaticResource ChirpPrimary}" Click="PasskeyClick"/>
                  <Button x:Name="Phone" HorizontalAlignment="Stretch" Style="{StaticResource ChirpButton}" Click="PhoneClick"/>
                  <HyperlinkButton x:Name="Register" Click="RegisterClick"/>
                </StackPanel>
                <ProgressBar x:Name="Working" IsIndeterminate="True" Visibility="Collapsed"/>
                <InfoBar x:Name="LoginNotice" IsOpen="False" IsClosable="True"/>
              </StackPanel>
              <Border Style="{StaticResource ChirpDivider}" Margin="0"/>
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ComboBox x:Name="LanguageChoice" HorizontalAlignment="Left" VerticalAlignment="Bottom" SelectionChanged="LanguageChanged"/>
                <DropDownButton x:Name="LocalOptions" Grid.Column="1" VerticalAlignment="Bottom">
                  <DropDownButton.Flyout>
                    <MenuFlyout>
                      <MenuFlyoutItem x:Name="ApproveSaved" Click="ApproveSavedClick" Visibility="Collapsed">
                        <MenuFlyoutItem.Icon><SymbolIcon Symbol="Permissions"/></MenuFlyoutItem.Icon>
                      </MenuFlyoutItem>
                      <MenuFlyoutItem x:Name="ManageLogs" Click="LogSettingsClick">
                        <MenuFlyoutItem.Icon><SymbolIcon Symbol="Document"/></MenuFlyoutItem.Icon>
                      </MenuFlyoutItem>
                      <MenuFlyoutItem x:Name="ClearDevice" Click="ClearLocalClick">
                        <MenuFlyoutItem.Icon><SymbolIcon Symbol="Delete"/></MenuFlyoutItem.Icon>
                      </MenuFlyoutItem>
                    </MenuFlyout>
                  </DropDownButton.Flyout>
                </DropDownButton>
              </Grid>
            </StackPanel>

            <Border x:Name="BrandPanel" Background="{ThemeResource SignInBackdropBrush}"
                    CornerRadius="7,0,0,7" MinHeight="428">
              <Grid Padding="0,30" RowSpacing="10">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="30,0">
                  <Image Source="Assets/Square44x44Logo.targetsize-48_altform-lightunplated.png" Width="30" Height="30"
                         AutomationProperties.AccessibilityView="Raw"/>
                  <TextBlock Text="Chirp" FontSize="19" FontWeight="SemiBold" Foreground="{ThemeResource SignInTextBrush}"
                             VerticalAlignment="Center"/>
                </StackPanel>
                <ContentControl Grid.Row="1" Style="{StaticResource ChirpRibbon}" Foreground="{ThemeResource CoverRibbonBrush}"/>
                <StackPanel Grid.Row="2" Spacing="7" Margin="32,0">
                  <TextBlock x:Name="WelcomeHeading" Style="{StaticResource ChirpHeading}" FontSize="30"
                             Foreground="{ThemeResource SignInTextBrush}"/>
                  <TextBlock x:Name="WelcomeDesc" Style="{StaticResource ChirpBody}"
                             Foreground="{ThemeResource SignInSecondaryBrush}"/>
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Border>
      </Grid>
    </ScrollViewer>

    <NavigationView x:Name="Nav" Grid.Row="1" Visibility="Collapsed" IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                    OpenPaneLength="224" CompactPaneLength="48" ExpandedModeThresholdWidth="1000" CompactModeThresholdWidth="0"
                    AlwaysShowHeader="False" KeyboardAcceleratorPlacementMode="Hidden" SelectionChanged="Navigated" ItemInvoked="NavInvoked">
      <NavigationView.KeyboardAccelerators>
        <KeyboardAccelerator Key="B" Modifiers="Control,Shift" Invoked="ChatShortcut"/>
      </NavigationView.KeyboardAccelerators>
      <NavigationView.PaneFooter>
        <Button x:Name="ProfileButton" Style="{StaticResource ChirpRowButton}" Padding="5,4" Margin="4,8,4,4" Click="ProfileClick">
          <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ContentPresenter x:Name="SidebarAvatar" VerticalAlignment="Center"/>
            <StackPanel x:Name="SidebarIdentity" Grid.Column="1" VerticalAlignment="Center" Spacing="2">
              <TextBlock x:Name="SidebarName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="ProfileLabel" Style="{StaticResource ChirpSecondary}" FontSize="12"/>
            </StackPanel>
          </Grid>
        </Button>
      </NavigationView.PaneFooter>
      <Border x:Name="RoomFrame" Background="{ThemeResource PageBrush}" BorderBrush="{ThemeResource EdgeBrush}"
              BorderThickness="1" CornerRadius="8" Margin="0,0,12,10">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid x:Name="WorkspaceHeader" Background="{ThemeResource PanelBrush}"
                CornerRadius="7,7,0,0" BorderBrush="{ThemeResource EdgeBrush}" BorderThickness="0,0,0,1">
            <Border x:Name="RoomCover" CornerRadius="7,7,0,0" Background="{ThemeResource RoomCoverBrush}"/>
            <Grid x:Name="HeaderContent" Padding="24,18" ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition x:Name="HeaderArtColumn" Width="0"/>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Grid VerticalAlignment="Center" RowSpacing="4">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel x:Name="HeaderTitle" Spacing="4">
                  <TextBlock x:Name="WorkspaceTitle" Style="{StaticResource ChirpHeading}" FontSize="28"
                             MaxLines="2" TextTrimming="CharacterEllipsis" AutomationProperties.HeadingLevel="Level1"/>
                  <TextBlock x:Name="RoomDescription" Style="{StaticResource ChirpSecondary}" FontSize="14"
                             MaxLines="2" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                </StackPanel>
                <Grid x:Name="HeaderContext" Grid.Row="1" ColumnSpacing="6">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <FontIcon x:Name="RoomKindIcon" FontSize="13" Style="{StaticResource ChirpBrandIcon}" VerticalAlignment="Center"
                            AutomationProperties.AccessibilityView="Raw"/>
                  <TextBlock x:Name="WorkspaceSubtitle" Grid.Column="1" Style="{StaticResource ChirpSecondary}" FontSize="13"/>
                </Grid>
              </Grid>
              <ContentControl x:Name="RoomRibbon" Grid.Column="1" Style="{StaticResource ChirpRibbon}" Height="80"
                              Foreground="{ThemeResource RoomRibbonBrush}"/>
            <Button x:Name="RoomDetails" Grid.Column="2" Width="40" VerticalAlignment="Center" Style="{StaticResource ChirpToolbarButton}"
                    Click="RoomDetailsClick" Visibility="Collapsed">
              <Button.KeyboardAccelerators><KeyboardAccelerator Key="I" Modifiers="Control,Menu"/></Button.KeyboardAccelerators>
              <FontIcon Glyph="&#xE946;" FontSize="16" AutomationProperties.AccessibilityView="Raw"/>
            </Button>
            <ToggleButton x:Name="ChatToggle" Grid.Column="3" MinHeight="40" VerticalAlignment="Center"
                          Checked="ChatToggled" Unchecked="ChatToggled" Visibility="Collapsed">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE8BD;" FontSize="16" AutomationProperties.AccessibilityView="Raw"/>
                <TextBlock x:Name="ChatToggleLabel" VerticalAlignment="Center"/>
                <InfoBadge x:Name="ChatUnread" Visibility="Collapsed" VerticalAlignment="Center"
                           AutomationProperties.AccessibilityView="Raw"/>
              </StackPanel>
            </ToggleButton>
            </Grid>
          </Grid>
          <InfoBar x:Name="Notice" Grid.Row="1" IsOpen="False" IsClosable="True" Margin="16,0"/>
          <InfoBar x:Name="RoomVerificationNotice" Grid.Row="2" Margin="12,8,12,0" MaxWidth="880"
                   HorizontalAlignment="Stretch" CornerRadius="8" Severity="Warning" IsClosable="False"
                   IsOpen="False" Visibility="Collapsed" AutomationProperties.AutomationId="RoomVerificationNotice"
                   Background="{ThemeResource RoomVerificationSurfaceBrush}" BorderBrush="{ThemeResource RoomVerificationEdgeBrush}">
            <InfoBar.Shadow><ThemeShadow/></InfoBar.Shadow>
            <ScrollViewer x:Name="VerificationActions" MaxHeight="88" Margin="0,0,0,8" HorizontalScrollMode="Disabled"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <local:ActionWrapPanel x:Name="VerificationTargets"/>
            </ScrollViewer>
          </InfoBar>
          <Grid Grid.Row="3" x:Name="WorkspaceGrid" SizeChanged="WorkspaceResized">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="StageWidth" Width="*"/><ColumnDefinition x:Name="ChatWidth" Width="0"/></Grid.ColumnDefinitions>
            <ScrollViewer x:Name="StageScroll" SizeChanged="StageResized" HorizontalContentAlignment="Stretch"
                          HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="Stage" Padding="24,20,24,24" Spacing="18"/>
            </ScrollViewer>
            <Border x:Name="ChatPanel" Grid.Column="1" Background="{ThemeResource PanelBrush}"
                    BorderBrush="{ThemeResource EdgeBrush}" BorderThickness="1,0,0,0" Visibility="Collapsed">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel x:Name="ChatHeader" Padding="16,14,16,12" Spacing="3" BorderBrush="{ThemeResource EdgeBrush}" BorderThickness="0,0,0,1">
                  <TextBlock x:Name="ChatTitle" Style="{StaticResource ChirpHeading}" FontSize="17" AutomationProperties.HeadingLevel="Level2"/>
                  <TextBlock x:Name="ChatLifetime" Style="{StaticResource ChirpSecondary}" FontSize="12"/>
                </StackPanel>
                <Grid Grid.Row="1">
                  <ListView x:Name="Messages" SizeChanged="ChatViewportResized"
                            SelectionMode="None" IsItemClickEnabled="False" Padding="10,6">
                    <ListView.ItemContainerStyle>
                      <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0,1"/>
                        <Setter Property="MinHeight" Value="0"/>
                      </Style>
                    </ListView.ItemContainerStyle>
                  </ListView>
                  <StackPanel x:Name="ChatEmpty" Margin="16,4" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                    <FontIcon x:Name="ChatEmptyIcon" Glyph="&#xE8BD;" FontSize="24" Margin="0,0,0,5"
                              Style="{StaticResource ChirpBrandIcon}" AutomationProperties.AccessibilityView="Raw"/>
                    <TextBlock x:Name="EmptyChatLabel" Style="{StaticResource ChirpHeading}" FontSize="16" TextAlignment="Center"/>
                    <TextBlock x:Name="EmptyChatDetail" Style="{StaticResource ChirpSecondary}" MaxWidth="240" FontSize="13" TextAlignment="Center"/>
                  </StackPanel>
                </Grid>
                <StackPanel x:Name="ChatComposer" Grid.Row="2" Background="{ThemeResource PageBrush}" BorderBrush="{ThemeResource EdgeBrush}"
                            BorderThickness="0,1,0,0" Padding="12" Spacing="8">
                  <TextBlock x:Name="ChatInputHint" Style="{StaticResource ChirpSecondary}" FontSize="12"/>
                  <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button x:Name="Attach" Width="40" VerticalAlignment="Bottom" Style="{StaticResource ChirpToolbarButton}" Click="AttachClick">
                      <FontIcon Glyph="&#xE723;" FontSize="16" AutomationProperties.AccessibilityView="Raw"/>
                    </Button>
                    <TextBox x:Name="Draft" Grid.Column="1" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="40" MaxHeight="100"
                             PreviewKeyDown="DraftKey" BeforeTextChanging="BeforeDraftChange" TextChanged="DraftChanged"
                             TextCompositionStarted="CompositionStarted" TextCompositionEnded="CompositionEnded"/>
                    <Button x:Name="SendChat" Grid.Column="2" Width="40" Padding="0" VerticalAlignment="Bottom"
                            Style="{StaticResource ChirpPrimary}" Click="SendClick">
                      <FontIcon Glyph="&#xE724;" FontSize="16" AutomationProperties.AccessibilityView="Raw"/>
                    </Button>
                  </Grid>
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
          <Border x:Name="RoomDock" Grid.Row="4" Background="{ThemeResource PanelBrush}" CornerRadius="0,0,7,7"
                  BorderBrush="{ThemeResource EdgeBrush}" BorderThickness="0,1,0,0" Padding="16,12" Visibility="Collapsed">
            <Grid x:Name="DockLayout" ColumnSpacing="12" SizeChanged="DockResized">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Grid x:Name="DockStatus" ColumnSpacing="10" VerticalAlignment="Center">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource ChirpInset}" Width="36" Height="36" VerticalAlignment="Center">
                  <Grid>
                    <FontIcon x:Name="DockStatusIcon" Style="{StaticResource ChirpBrandIcon}" FontSize="16"
                              AutomationProperties.AccessibilityView="Raw"/>
                    <ProgressRing x:Name="DockProgress" Width="20" Height="20" IsActive="False" Visibility="Collapsed"
                                  AutomationProperties.AccessibilityView="Raw"/>
                  </Grid>
                </Border>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                  <TextBlock x:Name="DockTitle" Style="{StaticResource ChirpHeading}" FontSize="14"
                             TextTrimming="CharacterEllipsis" MaxLines="1"/>
                  <TextBlock x:Name="DockDetail" Style="{StaticResource ChirpSecondary}" FontSize="12"/>
                </StackPanel>
              </Grid>
              <local:ActionWrapPanel x:Name="DockCommands" Grid.Column="1" VerticalAlignment="Center">
                <Button x:Name="DockAudio" Width="40" Style="{StaticResource ChirpToolbarButton}" Click="DockActionClick">
                  <FontIcon Glyph="&#xE713;" FontSize="16" AutomationProperties.AccessibilityView="Raw"/>
                </Button>
                <Button x:Name="DockResume" Style="{StaticResource ChirpButton}" Click="DockActionClick"/>
                <Button x:Name="DockCancel" Style="{StaticResource ChirpButton}" Click="DockActionClick"/>
                <Button x:Name="DockJoin" Style="{StaticResource ChirpPrimary}" Click="DockActionClick">
                  <Button.KeyboardAccelerators><KeyboardAccelerator Key="Enter" Modifiers="Control"/></Button.KeyboardAccelerators>
                </Button>
                <Button x:Name="DockMic" Style="{StaticResource ChirpButton}" Click="DockActionClick">
                  <Button.KeyboardAccelerators><KeyboardAccelerator Key="M" Modifiers="Control,Shift"/></Button.KeyboardAccelerators>
                </Button>
                <Button x:Name="DockLeave" Style="{StaticResource ChirpLeaveButton}" Click="DockActionClick">
                  <Button.KeyboardAccelerators><KeyboardAccelerator Key="L" Modifiers="Control,Shift"/></Button.KeyboardAccelerators>
                </Button>
              </local:ActionWrapPanel>
            </Grid>
          </Border>
        </Grid>
      </Border>
    </NavigationView>
  </Grid>
</Page>

    <Style x:Key="ChirpRibbon" TargetType="ContentControl">
      <Setter Property="Template" Value="{StaticResource VoiceRibbon}"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="IsHitTestVisible" Value="False"/>
      <Setter Property="AutomationProperties.AccessibilityView" Value="Raw"/>
    </Style>
    <Style x:Key="ChirpBody" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{ThemeResource InkBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="ChirpSecondary" TargetType="TextBlock" BasedOn="{StaticResource ChirpBody}">
      <Setter Property="Foreground" Value="{ThemeResource QuietBrush}"/>
    </Style>
    <Style x:Key="ChirpHeading" TargetType="TextBlock" BasedOn="{StaticResource ChirpBody}">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="20"/>
    </Style>
    <Style x:Key="ChirpCard" TargetType="Border">
      <Setter Property="Background" Value="{ThemeResource PanelBrush}"/>
      <Setter Property="BorderBrush" Value="{ThemeResource EdgeBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style x:Key="ChirpInset" TargetType="Border">
      <Setter Property="Background" Value="{ThemeResource SubtleBrush}"/>
      <Setter Property="CornerRadius" Value="6"/>
    </Style>
    <Style x:Key="ChirpDivider" TargetType="Border">
      <Setter Property="Background" Value="{ThemeResource EdgeBrush}"/>
      <Setter Property="Height" Value="1"/>
    </Style>
    <Style x:Key="ChirpMessage" TargetType="Border">
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="Background" Value="{ThemeResource SubtleBrush}"/>
      <Setter Property="CornerRadius" Value="3,8,8,8"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <Style x:Key="ChirpOwnMessage" TargetType="Border" BasedOn="{StaticResource ChirpMessage}">
      <Setter Property="Background" Value="{ThemeResource OwnMessageBrush}"/>
      <Setter Property="CornerRadius" Value="8,3,8,8"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>
    <Style x:Key="ChirpButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="Padding" Value="12,6"/>
    </Style>
    <Style x:Key="ChirpPrimary" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="Padding" Value="14,6"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="ChirpToolbarButton" TargetType="Button" BasedOn="{StaticResource ChirpButton}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="8,6"/>
    </Style>
    <Style x:Key="ChirpLeaveButton" TargetType="Button" BasedOn="{StaticResource ChirpButton}">
      <Setter Property="Foreground" Value="{ThemeResource DangerBrush}"/>
    </Style>
    <Style x:Key="ChirpRowButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="12,9"/>
      <Setter Property="MinHeight" Value="40"/>
    </Style>
    <Style x:Key="ChirpSurfaceButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="Background" Value="{ThemeResource PanelBrush}"/>
      <Setter Property="BorderBrush" Value="{ThemeResource EdgeBrush}"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="12"/>
    </Style>
    <Style x:Key="ChirpSpeakingTile" TargetType="Button" BasedOn="{StaticResource ChirpSurfaceButton}">
      <Setter Property="Background" Value="{ThemeResource SpeakingSurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{ThemeResource SpeakingInkBrush}"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="Padding" Value="11"/>
    </Style>
    <Style x:Key="ChirpBrandIcon" TargetType="FontIcon">
      <Setter Property="Foreground" Value="{ThemeResource BrandBrush}"/>
    </Style>
    <Style x:Key="ChirpAvatar0" TargetType="PersonPicture">
      <Setter Property="Background" Value="{ThemeResource Avatar0Fill}"/>
      <Setter Property="Foreground" Value="{ThemeResource Avatar0Ink}"/>
    </Style>
    <Style x:Key="ChirpAvatar1" TargetType="PersonPicture">
      <Setter Property="Background" Value="{ThemeResource Avatar1Fill}"/>
      <Setter Property="Foreground" Value="{ThemeResource Avatar1Ink}"/>
    </Style>
    <Style x:Key="ChirpAvatar2" TargetType="PersonPicture">
      <Setter Property="Background" Value="{ThemeResource Avatar2Fill}"/>
      <Setter Property="Foreground" Value="{ThemeResource Avatar2Ink}"/>
    </Style>
    <Style x:Key="ChirpAvatar3" TargetType="PersonPicture">
      <Setter Property="Background" Value="{ThemeResource Avatar3Fill}"/>
      <Setter Property="Foreground" Value="{ThemeResource Avatar3Ink}"/>

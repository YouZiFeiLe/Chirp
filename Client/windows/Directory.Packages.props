<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="2.7.0" />
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.8.0" />
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools.WinUIAnalyzer" Version="0.8.0" />
    <PackageVersion Include="NAudio.Wasapi" Version="3.3.0" />
    <PackageVersion Include="Concentus" Version="2.2.3" />
    <PackageVersion Include="OpusSharp.Natives" Version="1.6.1.4" />
    <PackageVersion Include="QRCoder" Version="1.9.0" />
    <PackageVersion Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>
  <ItemGroup>
    <!-- Transitive dependencies of WinUI, QRCoder and NAudio. -->
    <PackageVersion Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools.MSIX" Version="1.7.261119100" />
    <PackageVersion Include="System.Drawing.Common" Version="11.0.0" />
    <PackageVersion Include="System.Numerics.Tensors" Version="11.0.0" />
  </ItemGroup>
</Project>
